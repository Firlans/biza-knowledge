{
  "description": "Load canonical .agents rules before prompts, shell commands, and file edits.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"{project_root}/.agents/hooks/read_rules.py\"",
            "commandWindows": "python -X utf8 \"{project_root}/.agents/hooks/read_rules.py\"",
            "timeout": 10,
            "additionalContextLimit": 5000,
            "statusMessage": "Memuat rules proyek"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"{project_root}/.agents/hooks/read_rules.py\"",
            "commandWindows": "python -X utf8 \"{project_root}/.agents/hooks/read_rules.py\"",
            "timeout": 10,
            "additionalContextLimit": 5000,
            "statusMessage": "Membaca rules sebelum eksekusi"
          }
        ]
      }
    ]
  }
}
